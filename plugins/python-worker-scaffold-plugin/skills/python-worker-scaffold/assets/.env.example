# Worker Configuration
WORKER_NAME={{PROJECT_NAME}}
LOG_LEVEL=INFO

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
QUEUE_NAME={{PROJECT_NAME}}_queue
PREFETCH_COUNT=10

# RabbitMQ Connection (for docker-compose)
RABBIT_USER=guest
RABBIT_PASSWORD=guest
RABBIT_PORT=5672
RABBIT_MGMT_PORT=15672

# CloudEvents Signing (generate your own keys!)
# Generate with: ssh-keygen -t rsa -b 2048 -m PEM -f cloudevents_key
# Private key (PEM format)
CLOUDEVENTS_SIGNING_KEY="-----BEGIN RSA PRIVATE KEY-----
YOUR_PRIVATE_KEY_HERE
-----END RSA PRIVATE KEY-----"

# Public key (PEM format)  
CLOUDEVENTS_VERIFICATION_KEY="-----BEGIN PUBLIC KEY-----
YOUR_PUBLIC_KEY_HERE
-----END PUBLIC KEY-----"

# Worker Behavior
MAX_RETRIES=3
RETRY_DELAY=60
